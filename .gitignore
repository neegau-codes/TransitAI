# Python bytecode cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Generated / runtime database files
database/transit.db
database/validation_report.json

# IDE and editor settings
.vscode/
.idea/
*.swp
*.swo
*~

# OS-generated files
.DS_Store
Thumbs.db

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Testing and coverage
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Environment variables
.env
.env.local

# Logs
*.log